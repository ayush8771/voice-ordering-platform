# Backend-only environment placeholders. Copy to backend/.env and never commit
# real values (docs/SECURITY.md section 3). Runtime/Mongo/Gnani placeholders
# live in the repository-root .env.example.

# --- Sarvam AI conversational LLM ---
# Server-side only. The key is never sent to a client and never logged.
# Endpoint used by the adapter: POST {SARVAM_BASE_URL}/v1/chat/completions
# Auth header: api-subscription-key
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_BASE_URL=https://api.sarvam.ai

# Per-request timeout in ms (integer 1000-120000). Default 15000.
SARVAM_TIMEOUT_MS=15000

# --- Conversation service budgets ---
# All optional; the service applies the documented defaults when unset.
LLM_MAX_OUTPUT_TOKENS=400
CONVERSATION_MAX_INPUT_CHARS=600
CONVERSATION_HISTORY_TURNS=8
CONVERSATION_MAX_TOOL_ROUNDS=2
CONVERSATION_SESSION_TTL_MS=1800000
CONVERSATION_MAX_SESSIONS=500
