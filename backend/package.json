{
  "name": "@vop/backend",
  "private": true,
  "version": "0.0.0",
  "description": "Node.js API, order processing and provider adapters",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seedMenu.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vop/shared": "*",
    "cors": "2.8.5",
    "express": "5.3.0",
    "mongodb": "7.8.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "26.6.6",
    "@types/supertest": "6.0.2",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
