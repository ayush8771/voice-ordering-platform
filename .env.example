# Copy to backend/.env for local development. Placeholder names only - never commit real values.
# See docs/SECURITY.md section 3.

# --- Backend runtime ---
PORT=4000
NODE_ENV=development

# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- MongoDB ---
# Local example: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB_NAME=voice_ordering_dev

# --- Gnani speech providers (NOT INTEGRATED) ---
# Provider API contracts are unverified (docs/PRD.md section 5). These names are
# placeholders so credentials are never hardcoded; no adapter reads them yet.
GNANI_PRISMA_STT_API_KEY=
GNANI_PRISMA_STT_BASE_URL=
GNANI_TIMBRE_TTS_API_KEY=
GNANI_TIMBRE_TTS_BASE_URL=

# --- Sarvam AI conversational LLM (backend only) ---
# Planned primary conversational LLM (CLAUDE.md). Read server-side by
# backend/src/providers/sarvam; the key never reaches a client bundle or a log.
# Verified: POST {SARVAM_BASE_URL}/v1/chat/completions, header api-subscription-key.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_MS=15000

# --- Undecided, intentionally absent ---
# Staff authentication provider, payment provider and callback signing secrets
# are open decisions (docs/PRD.md section 9). Do not add guessed variables here.

# --- Conversation service budgets (backend only) ---
# Defaults are applied when unset; see docs/PROVIDERS.md.
LLM_MAX_OUTPUT_TOKENS=400
CONVERSATION_MAX_INPUT_CHARS=600
CONVERSATION_HISTORY_TURNS=8
CONVERSATION_MAX_TOOL_ROUNDS=2
CONVERSATION_SESSION_TTL_MS=1800000
CONVERSATION_MAX_SESSIONS=500
